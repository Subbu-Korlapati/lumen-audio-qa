# Frontend configuration. Copy to .env for local overrides.
#
# Base URL the browser uses to reach the backend API.
# Leave empty to use the Vite dev proxy (recommended in development), which
# forwards /ask and /health to the Flask backend on http://localhost:5000.
VITE_API_BASE_URL=

# Backend target the Vite dev proxy forwards to (build/dev tooling only, not the browser).
# Defaults to :8000 (port 5000 is often taken by macOS/Cursor). Point this at
# wherever the Flask backend is actually listening.
VITE_BACKEND_URL=http://localhost:8000
