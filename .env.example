# Use your own model and key — there's nothing to request from us.
# Copy this file to .env and set your own provider, key, and models.
#
# This app uses lexical retrieval, so no embedding model/API is required.
#
# --- Anthropic (Messages API) ---
LLM_PROVIDER=anthropic
LLM_API_BASE=https://api.anthropic.com
LLM_API_KEY=your-own-key-here
LLM_CHAT_MODEL=claude-sonnet-4-6
#
# --- OpenAI-compatible (Chat Completions), incl. Azure OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=your-own-key-here
# LLM_CHAT_MODEL=gpt-4o-mini
